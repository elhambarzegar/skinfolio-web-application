// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Accounts -----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  intakeResponses IntakeResponse[]
  routines        Routine[]
  checkIns        CheckIn[]
}

// --- Intake ---------------------------------------------------------------

enum ExperienceLevel {
  NO_ROUTINE
  INCONSISTENT
  HAS_ROUTINE_UNSURE
  KNOWLEDGEABLE
}

enum Priority {
  USE_OWNED
  ONE_BETTER_PRODUCT
  BEST_RESULTS
  MINIMIZE_SPEND
}

enum ComplexityPreference {
  SIMPLEST
  FEW_EXTRA_OK
  ENJOYS_SKINCARE
}

model IntakeResponse {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerns             String[]
  questionnaire        String
  experienceLevel      ExperienceLevel?
  priority             Priority?
  complexityPreference ComplexityPreference?
  safetyAcknowledged   Boolean               @default(false)
  ownedProducts        Product[]             @relation("IntakeOwnedProducts")
  createdAt            DateTime              @default(now())
}

// --- Product catalog --------------------------------------------------------

enum ProductStep {
  CLEANSE
  TREAT
  MOISTURIZE
  PROTECT
  OTHER
}

model Product {
  id          String   @id @default(cuid())
  step        ProductStep
  brand       String
  name        String
  priceCad    Float?
  size        String?
  description String?
  createdAt   DateTime @default(now())

  sources          ProductSource[]
  currentSourceId  String?         @unique
  currentSource    ProductSource?  @relation("CurrentSource", fields: [currentSourceId], references: [id])

  intakeAppearances IntakeResponse[] @relation("IntakeOwnedProducts")
  routineSteps      RoutineStep[]
}

enum SourceOrigin {
  OPEN_BEAUTY_FACTS
  BRAND_SITE
  RETAILER
  WEB_SEARCH
  USER_PHOTO
}

enum DatePrecision {
  EXACT
  MONTH
  YEAR
  UNKNOWN
}

enum SourceStatus {
  PENDING
  VERIFIED
  SUPERSEDED
  REJECTED
}

// Append-only audit trail: every lookup (structured or web-fallback) writes
// a new row here. Rows are never edited or deleted, only superseded.
model ProductSource {
  id                    String        @id @default(cuid())
  productId             String
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  origin                SourceOrigin
  sourceUrl             String?
  ingredientsInci       String
  rawExtract            String
  fetchedAt             DateTime      @default(now())
  publishedAt           DateTime?
  publishedAtPrecision  DatePrecision @default(UNKNOWN)
  confidenceScore       Int
  confidenceBreakdown   Json
  status                SourceStatus  @default(PENDING)
  supersededById        String?       @unique
  supersededBy          ProductSource? @relation("SourceHistory", fields: [supersededById], references: [id])
  supersedes            ProductSource? @relation("SourceHistory")
  currentForProduct     Product?      @relation("CurrentSource")
}

// --- Routines ---------------------------------------------------------------

enum RoutineStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Routine {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         RoutineStatus @default(DRAFT)
  rationale      String
  // Rule numbers (see lib/routine/policy.ts RULE_SOURCES) cited by the
  // overview, resolved to real source links at render time — never an
  // LLM-generated URL.
  overviewSources Int[]
  createdAt      DateTime      @default(now())

  steps    RoutineStep[]
  checkIns CheckIn[]
  proTips  ProTip[]
}

enum TimeOfDay {
  AM
  PM
}

enum StepProposal {
  KEEP
  REMOVE
  ADD
  CHANGE
}

enum ProductOwnership {
  OWNED
  NEW
}

enum BudgetAdjustment {
  NONE
  FREQUENCY_REDUCED
  DROPPED_FOR_BUDGET
}

model RoutineStep {
  id                String    @id @default(cuid())
  routineId         String
  routine           Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  // Null only for a proposal: "ADD" step — a described gap with nothing
  // owned yet. Every other proposal always has a real owned product.
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id])
  timeOfDay         TimeOfDay
  order             Int
  rationale         String
  ackLowConfidence  Boolean?
  decidedAt         DateTime?
  // Soft-delete: a step is never hard-deleted once a ProTip can reference
  // it, so accept/reject history (and the step's own audit trail) survives
  // a "remove"/discarded-"add" resolution. Every routine-steps query
  // filters to active: true.
  active            Boolean   @default(true)

  frequencyPerWeek       Int              @default(7)
  timeCostMinutes        Int?
  ownership              ProductOwnership @default(OWNED)
  proposal               StepProposal     @default(KEEP)
  proposalReason         String?
  // Rule number cited (see RULE_SOURCES), or null for "none".
  ruleCitation           Int?
  // Generic, brand-agnostic description of what would fill this slot
  // better — set for "ADD" (paired with suggestedCategory) and for a
  // "CHANGE" that isn't just a frequency tweak. The app never names a
  // specific product here; it renders shop-search links from this text
  // instead (see lib/shopLinks.ts).
  suggestedCategory      ProductStep?
  suggestedDescription   String?
  alternativeFrequency   Int?
  budgetAdjustment       BudgetAdjustment @default(NONE)
  budgetAdjustmentReason String?

  proTips ProTip[]
}

enum ProTipAction {
  ADD
  REMOVE
  CHANGE
  KEEP
}

enum ProTipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// One proposed change to the routine, surfaced as a one-sentence card with
// accept/reject. ADD/REMOVE/CHANGE tips stay visible (dashboard + routine
// page) until responded to; KEEP tips are low-stakes affirmations that
// don't need to nag.
model ProTip {
  id            String       @id @default(cuid())
  routineId     String
  routine       Routine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  summary       String
  actionType    ProTipAction
  ruleCitation  Int?
  primaryStepId String
  primaryStep   RoutineStep  @relation(fields: [primaryStepId], references: [id])
  status        ProTipStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())
}

// --- Check-ins & escalation --------------------------------------------------

enum Adherence {
  DONE
  SKIPPED
}

model CheckIn {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId     String?
  routine       Routine?  @relation(fields: [routineId], references: [id])
  dayNumber     Int
  timeOfDay     TimeOfDay
  adherence     Adherence
  symptomsText  String?
  createdAt     DateTime  @default(now())

  escalation EscalationFlag?
}

model EscalationFlag {
  id         String    @id @default(cuid())
  checkInId  String    @unique
  checkIn    CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}
