// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Accounts -----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Null for an account that signs in with Google only.
  passwordHash String?
  name         String?
  image        String?
  // Set when a provider (Google) has vouched that the person controls this
  // address. Email-and-password signups leave it null until then.
  emailVerified DateTime?
  createdAt    DateTime @default(now())
  // IANA zone (e.g. "America/Vancouver"), synced from the browser, so
  // "today" and the weekday are the user's own, not the server's.
  timezone     String   @default("UTC")

  intakeResponses IntakeResponse[]
  shelfItems      ShelfItem[]
  routineChanges  RoutineChange[]
  photoReports    ProductSource[] @relation("PhotoReporter")
  routines        Routine[]
  checkIns        CheckIn[]
  stepLogs        StepLog[]
}

// --- Intake ---------------------------------------------------------------

enum ExperienceLevel {
  NO_ROUTINE
  INCONSISTENT
  HAS_ROUTINE_UNSURE
  KNOWLEDGEABLE
}

enum Priority {
  USE_OWNED
  ONE_BETTER_PRODUCT
  BEST_RESULTS
  MINIMIZE_SPEND
}

enum ComplexityPreference {
  SIMPLEST
  FEW_EXTRA_OK
  ENJOYS_SKINCARE
}

model IntakeResponse {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerns             String[]
  questionnaire        String
  experienceLevel      ExperienceLevel?
  priority             Priority?
  complexityPreference ComplexityPreference?
  safetyAcknowledged   Boolean               @default(false)
  ownedProducts        Product[]             @relation("IntakeOwnedProducts")
  createdAt            DateTime              @default(now())
}

// --- Product catalog --------------------------------------------------------

enum ProductStep {
  CLEANSE
  TREAT
  MOISTURIZE
  PROTECT
  OTHER
}

model Product {
  id          String   @id @default(cuid())
  step        ProductStep
  brand       String
  name        String
  priceCad    Float?
  size        String?
  description String?
  createdAt   DateTime @default(now())
  // When we last tried to find this product's ingredients online, found or
  // not. Lets a failed lookup be retried later (but not on every request).
  lastLookupAt DateTime?

  sources          ProductSource[]
  currentSourceId  String?         @unique
  currentSource    ProductSource?  @relation("CurrentSource", fields: [currentSourceId], references: [id])

  intakeAppearances IntakeResponse[] @relation("IntakeOwnedProducts")
  routineSteps      RoutineStep[]
  shelfItems        ShelfItem[]
}

enum SourceOrigin {
  OPEN_BEAUTY_FACTS
  BRAND_SITE
  RETAILER
  WEB_SEARCH
  USER_PHOTO
  /// The same list, reported from their own label photos by several different people.
  COMMUNITY
}

enum DatePrecision {
  EXACT
  MONTH
  YEAR
  UNKNOWN
}

enum SourceStatus {
  PENDING
  VERIFIED
  SUPERSEDED
  REJECTED
}

// Append-only audit trail: every lookup (structured or web-fallback) writes
// a new row here. Rows are never edited or deleted, only superseded.
model ProductSource {
  id                    String        @id @default(cuid())
  productId             String
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  origin                SourceOrigin
  sourceUrl             String?
  ingredientsInci       String
  rawExtract            String
  fetchedAt             DateTime      @default(now())
  publishedAt           DateTime?
  publishedAtPrecision  DatePrecision @default(UNKNOWN)
  confidenceScore       Int
  confidenceBreakdown   Json
  status                SourceStatus  @default(PENDING)
  supersededById        String?       @unique
  supersededBy          ProductSource? @relation("SourceHistory", fields: [supersededById], references: [id])
  supersedes            ProductSource? @relation("SourceHistory")
  currentForProduct     Product?      @relation("CurrentSource")
  // Set when this is one person's own photo of the label: it belongs to their
  // shelf item, never to the shared library.
  photoForShelfItem     ShelfItem?    @relation("ShelfPhotoSource")
  // For a label photo: the account that took it. Used only to count how many
  // different people agree; never shown. If the account is deleted the report stops counting.
  reporterId            String?
  reporter              User?         @relation("PhotoReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([productId, origin])
}

// --- Routines ---------------------------------------------------------------

enum RoutineStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Routine {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         RoutineStatus @default(DRAFT)
  rationale      String
  // Rule numbers (see lib/routine/policy.ts RULE_SOURCES) cited by the
  // overview, resolved to real source links at render time — never an
  // LLM-generated URL.
  overviewSources Int[]
  createdAt      DateTime      @default(now())
  // When the user approved this routine. Adherence reports only count days
  // from here on; null on routines approved before this field existed.
  activatedAt    DateTime?

  steps    RoutineStep[]
  checkIns CheckIn[]
  proTips  ProTip[]
  stepLogs StepLog[]
  changes  RoutineChange[]
}

enum TimeOfDay {
  AM
  PM
}

enum StepProposal {
  KEEP
  REMOVE
  ADD
  CHANGE
}

enum ProductOwnership {
  OWNED
  NEW
}

enum BudgetAdjustment {
  NONE
  FREQUENCY_REDUCED
  DROPPED_FOR_BUDGET
}

model RoutineStep {
  id                String    @id @default(cuid())
  routineId         String
  routine           Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  // Null only for a proposal: "ADD" step — a described gap with nothing
  // owned yet. Every other proposal always has a real owned product.
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id])
  timeOfDay         TimeOfDay
  order             Int
  rationale         String
  ackLowConfidence  Boolean?
  decidedAt         DateTime?
  // Soft-delete: a step is never hard-deleted once a ProTip can reference
  // it, so accept/reject history (and the step's own audit trail) survives
  // a "remove"/discarded-"add" resolution. Every routine-steps query
  // filters to active: true.
  active            Boolean   @default(true)

  frequencyPerWeek       Int              @default(7)
  timeCostMinutes        Int?
  ownership              ProductOwnership @default(OWNED)
  proposal               StepProposal     @default(KEEP)
  proposalReason         String?
  // Rule number cited (see RULE_SOURCES), or null for "none".
  ruleCitation           Int?
  // Generic, brand-agnostic description of what would fill this slot
  // better — set for "ADD" (paired with suggestedCategory) and for a
  // "CHANGE" that isn't just a frequency tweak. The app never names a
  // specific product here; it renders shop-search links from this text
  // instead (see lib/shopLinks.ts).
  suggestedCategory      ProductStep?
  suggestedDescription   String?
  alternativeFrequency   Int?
  budgetAdjustment       BudgetAdjustment @default(NONE)
  budgetAdjustmentReason String?

  proTips  ProTip[]
  stepLogs StepLog[]
}

// One row per scheduled step per local calendar day. The row is created
// when the day's checklist is first opened (a snapshot of "what was due"),
// and doneAt is filled in when the user ticks it off. Reports are built
// from these rows.
model StepLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId String
  routine   Routine     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  stepId    String
  step      RoutineStep @relation(fields: [stepId], references: [id])
  // The user's local day as "YYYY-MM-DD". A string, so a day never shifts
  // when the server's clock or zone differs from the user's.
  date      String
  doneAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([stepId, date])
  @@index([userId, date])
}

enum ProTipAction {
  ADD
  REMOVE
  CHANGE
  KEEP
}

enum ProTipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// One proposed change to the routine, surfaced as a one-sentence card with
// accept/reject. ADD/REMOVE/CHANGE tips stay visible (dashboard + routine
// page) until responded to; KEEP tips are low-stakes affirmations that
// don't need to nag.
model ProTip {
  id            String       @id @default(cuid())
  routineId     String
  routine       Routine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  summary       String
  actionType    ProTipAction
  ruleCitation  Int?
  primaryStepId String
  primaryStep   RoutineStep  @relation(fields: [primaryStepId], references: [id])
  status        ProTipStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())
}

// --- Check-ins & escalation --------------------------------------------------

enum Adherence {
  DONE
  SKIPPED
}

model CheckIn {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId     String?
  routine       Routine?  @relation(fields: [routineId], references: [id])
  dayNumber     Int
  timeOfDay     TimeOfDay
  adherence     Adherence
  symptomsText  String?
  createdAt     DateTime  @default(now())

  escalation EscalationFlag?
}

model EscalationFlag {
  id         String    @id @default(cuid())
  checkInId  String    @unique
  checkIn    CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

enum ShelfStatus {
  ACTIVE
  RAN_OUT
}

/// One product on one person's shelf. Whether it is in their routine is not
/// stored here: that is whatever their current routine says.
model ShelfItem {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  status    ShelfStatus @default(ACTIVE)
  ranOutAt  DateTime?
  addedAt   DateTime    @default(now())

  // Prescribed by a doctor or other professional: the routine is built
  // around it, not the other way round.
  prescribed Boolean @default(false)
  // Their prescriber's directions, in their own words.
  directions String?

  // The person's own photo of this product's label. When set it is used
  // instead of the app library's ingredient list, for this person only.
  photoSourceId String?        @unique
  photoSource   ProductSource? @relation("ShelfPhotoSource", fields: [photoSourceId], references: [id])

  @@unique([userId, productId])
  @@index([userId, status])
}

enum ChangeKind {
  /// A shelf product the person wants in the routine.
  USE_PRODUCT
  /// A prescribed product, which the routine adapts around.
  PRESCRIBED
  /// A new product taking the place of one that ran out.
  SWAP
  /// An automatic check after something changed (e.g. a label photo).
  RECHECK
}

enum ChangeStatus {
  PENDING
  APPLIED
  DISMISSED
  /// The routine changed after this was suggested, so it no longer fits.
  STALE
}

/// A suggested change to the routine in use. Nothing is applied until the
/// person has read it and approved it; what gets applied is exactly what is
/// stored here, never what the browser sends back.
model RoutineChange {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId    String
  routine      Routine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  kind         ChangeKind
  status       ChangeStatus @default(PENDING)
  // What set this off, in the person's terms ("You added a photo of ...").
  trigger      String
  // One sentence: what is being proposed.
  summary      String
  // Plain-language "what this means for you" points.
  consequences Json
  risk         String       @default("none")
  // The exact operations to apply, and the same thing as readable lines.
  ops          Json
  diff         Json
  createdAt    DateTime     @default(now())
  // When they pressed "I understand, make this change" (or dismissed it).
  decidedAt    DateTime?

  @@index([userId, status])
}
